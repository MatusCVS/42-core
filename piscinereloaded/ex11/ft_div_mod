#include <stdio.h>
void    ft_div_mod(int a, int b, int *div, int *mod)

{
    *div = a / b;
    *mod = a % b;
}

int main(void)
{
    int a;
    int b;
    int div;
    int mod;

    a = 18;
    b = 9;
    ft_div_mod(a, b, &div, &mod);
    ft_div_mod(a, b, &div, &mod);
	printf("Division: %d\n", div);
	printf("Modulo: %d\n", mod);
    return (0);
}
